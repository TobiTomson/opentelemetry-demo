<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <ProtosDir>$(ProjectDir)..\pb</ProtosDir>
  </PropertyGroup>

  <PropertyGroup Condition="!Exists('$(ProtosDir)')">
    <ProtosDir>$(ProjectDir)..\..\..\pb</ProtosDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" />
    <PackageReference Include="Grpc.Net.Client" />
    <!-- Server-side OpenTelemetry SDK is decoupled from application source: it is
         supplied by OpenTelemetry.AutoInstrumentation, injected at the container
         layer via instrument.sh (see the Dockerfile). Application code uses only
         the System.Diagnostics ActivitySource/Meter API. -->
    <PackageReference Include="OpenTelemetry.AutoInstrumentation" />
    <!-- .NET auto-instrumentation requires the StackExchange.Redis instrumentation
         to be published as a build asset for the profiler to trace Redis; it is not
         referenced by application source. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="OpenFeature.Providers.Flagd" />
    <PackageReference Include="OpenFeature" />
    <PackageReference Include="OpenFeature.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="$(ProtosDir)\**\*.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
